{
  "name": "tic-tac-toe",
  "private": true,
  "scripts": {
    "start": "meteor run --settings settings.json",
    "test": "TEST_WATCH=1 meteor test --driver-package meteortesting:mocha",
    "test:headless": "meteor test --once --driver-package meteortesting:mocha",
    "visualize": "meteor --production --extra-packages bundle-visualizer",
    "lint": "npx oxlint --react-plugin --import-plugin .",
    "lint:fix": "npx oxlint --react-plugin --import-plugin . --fix",
    "e2e": "npx playwright test --ui",
    "e2e:headless": "npx playwright test",
    "types": "meteor types",
    "typecheck": "meteor types && tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@swc/helpers": "^0.5.23",
    "meteor-node-stubs": "^1.2.27",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.1",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@meteorjs/rspack": "^3.0.0-beta.2",
    "@playwright/test": "^1.50.0",
    "@rsdoctor/rspack-plugin": "^1.5.9",
    "@rspack/cli": "^2.2.0",
    "@rspack/core": "^2.2.0",
    "@rspack/dev-server": "^2.2.0",
    "@rspack/plugin-react-refresh": "^2.0.0",
    "@swc/core": "^1.15.32",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.56.0",
    "react-refresh": "^0.18.0",
    "typescript": "^5.9.3"
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.tsx",
      "server": "server/main.ts"
    },
    "testModule": "tests/main.js",
    "modern": true
  }
}
