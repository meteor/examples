{
  "name": "task-manager",
  "scripts": {
    "start": "meteor run --settings settings.json",
    "test": "TEST_WATCH=1 meteor test --driver-package meteortesting:mocha",
    "test:headless": "meteor test --once --driver-package meteortesting:mocha",
    "lint": "npx @biomejs/biome check .",
    "lint:fix": "npx @biomejs/biome check . --write",
    "e2e": "npx playwright test --ui",
    "e2e:headless": "npx playwright test",
    "types": "meteor types",
    "typecheck": "meteor types && tsc --noEmit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@swc/helpers": "^0.5.23",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "meteor-node-stubs": "^1.2.27",
    "meteor-rpc": "1.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@meteorjs/rspack": "^3.0.0-beta.2",
    "@playwright/test": "^1.50.0",
    "@rsdoctor/rspack-plugin": "^1.5.9",
    "@rspack/cli": "^2.2.0",
    "@rspack/core": "^2.2.0",
    "@rspack/dev-server": "^2.2.0",
    "@rspack/plugin-react-refresh": "^2.0.0",
    "@swc/core": "^1.15.32",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.remove": "^4.7.9",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.8",
    "postcss-loader": "^8.2.1",
    "react-refresh": "^0.18.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.tsx",
      "server": "server/main.ts"
    },
    "testModule": "tests/main.js",
    "modern": true
  }
}
