    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@swc/helpers": "^0.5.23",
    "framework7": "^9.0.5",
    "framework7-react": "^9.0.5",
    "meteor-node-stubs": "^1.2.27",
