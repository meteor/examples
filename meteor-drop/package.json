{
  "name": "meteor-drop",
  "private": true,
  "scripts": {
    "start": "meteor run",
    "test": "TEST_WATCH=1 meteor test --driver-package meteortesting:mocha",
    "test:headless": "meteor test --once --driver-package meteortesting:mocha",
    "lint": "npx oxlint --react-plugin --import-plugin .",
    "lint:fix": "npx oxlint --react-plugin --import-plugin --fix .",
    "e2e": "npx playwright test --ui",
    "e2e:headless": "npx playwright test",
    "e2e:gallery": "METEOR_DROP_GALLERY=1 npx playwright test e2e/gallery.spec.js",
    "test:gallery-output": "node --test e2e/gallery-output.test.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@swc/helpers": "^0.5.23",
    "konsta": "^5.2.0",
    "lucide-react": "^1.25.0",
    "meteor-node-stubs": "^1.2.27",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.2",
    "@meteorjs/capacitor": "^0.2.0-alpha.1",
    "@meteorjs/rspack": "^3.0.0",
    "@playwright/test": "^1.50.0",
    "@rsdoctor/rspack-plugin": "^1.6.4",
    "@rspack/cli": "^2.2.7",
    "@rspack/core": "^2.2.7",
    "@rspack/dev-server": "^2.2.1",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@swc/core": "^1.16.2",
    "@tailwindcss/postcss": "^4.3.3",
    "oxlint": "^1.56.0",
    "postcss": "^8.5.20",
    "postcss-load-config": "^6.0.1",
    "postcss-loader": "^8.2.1",
    "react-refresh": "^0.19.0",
    "tailwindcss": "^4.3.3"
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.jsx",
      "server": "server/main.js"
    },
    "testModule": "tests/main.js",
    "capacitor": {
      "hcp": "webapp"
    },
    "modern": true
  }
}
