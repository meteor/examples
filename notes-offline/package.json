{
  "name": "notes-offline",
  "private": true,
  "scripts": {
    "start": "node ../scripts/start-example.mjs",
    "test": "TEST_WATCH=1 meteor test --driver-package meteortesting:mocha",
    "test:headless": "meteor test --once --driver-package meteortesting:mocha",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "e2e": "npx playwright test --ui",
    "e2e:headless": "npx playwright test",
    "i18n:extract": "lingui extract --clean",
    "prepare:assets": "lingui compile --strict && node scripts/service-worker.cjs",
    "prestart": "npm run prepare:assets"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@lingui/core": "^5.9.5",
    "@lingui/macro": "^5.9.5",
    "@lingui/react": "^5.9.5",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/notifications": "^8.3.18",
    "@swc/helpers": "^0.5.19",
    "@tabler/icons-react": "^3.40.0",
    "meteor-node-stubs": "^1.2.27",
    "postcss": "^8.5.8",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "8.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@lingui/cli": "^5.9.5",
    "@lingui/format-json": "^5.9.5",
    "@playwright/test": "^1.50.0",
    "@types/meteor": "^2.9.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "prettier": "^3.4.0",
    "postcss-load-config": "6.0.1",
    "workbox-build": "7.4.0",
    "babel-plugin-macros": "3.1.0",
    "@babel/plugin-transform-react-jsx": "7.27.1"
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.jsx",
      "server": "server/main.js"
    },
    "testModule": "tests/main.js",
    "modern": {
      "transpiler": {
        "excludeApp": true
      }
    }
  }
}
